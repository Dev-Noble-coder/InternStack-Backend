NODE_ENV=development
PORT=4000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_URI=mongodb://127.0.0.1:27017/internstack
CLIENT_URL=http://localhost:5173
VERIFY_EMAIL_URL=http://localhost:5173/verify-email
RESET_PASSWORD_URL=http://localhost:5173/reset-password
SUPPORT_URL=http://localhost:5173/contact
APP_TIME_ZONE=Africa/Lagos
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_COOKIE_MAX_AGE_MS=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
REGISTER_RATE_LIMIT=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_CODE_RATE_LIMIT=5
EMAIL_CODE_RATE_LIMIT_WINDOW_MS=600000
RESEND_RATE_LIMIT=3
RESEND_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
